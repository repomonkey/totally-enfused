<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the Python runtime's JIT / unsigned memory (needed by rawpy/LibRaw) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading unsigned dylibs (pyobjc, rawpy's LibRaw) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Read access to user-selected files via NSOpenPanel -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Write access to user-selected output location -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
